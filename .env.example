# Poort waarop de app luistert
PORT=3000

# Productie-API's van Voys (standaardwaarden; alleen aanpassen voor test/white-label-omgevingen)
VOYS_API_BASE=https://api.voys.nl
HOLODECK_API_BASE=https://api.eu-production.holodeck.voys.nl

# In productie altijd true (app draait achter HTTPS). Alleen lokaal zonder HTTPS op false.
COOKIE_SECURE=true
# true als de app achter een reverse proxy (nginx, Traefik, Caddy) draait
TRUST_PROXY=true

# Na hoeveel minuten inactiviteit een gebruiker opnieuw moet inloggen
SESSION_IDLE_MINUTES=480
# Hoe lang de contactenlijst per sessie gecachet wordt
CONTACTS_CACHE_SECONDS=60

# Brute-force-bescherming op het loginformulier
LOGIN_MAX_ATTEMPTS=10
LOGIN_MAX_ATTEMPTS_PER_IP=50
LOGIN_WINDOW_MINUTES=15

# Naam in de titelbalk en op het inlogscherm
APP_NAME=Contacten & Bellen
